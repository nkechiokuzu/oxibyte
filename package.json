{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "tunnel": "tools\\cloudflared.exe tunnel --url http://localhost:5000",
    "adb:reverse": "powershell -Command \"& '$env:LOCALAPPDATA\\Android\\Sdk\\platform-tools\\adb.exe' reverse tcp:5000 tcp:5000\""
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
